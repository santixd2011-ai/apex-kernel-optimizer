<Window x:Class="ApexKernelOptimizer.Views.ToolWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herramienta nativa" Width="1060" Height="780" MinWidth="840" MinHeight="620"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="ActionCard" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#263039" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#30433C" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,18">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border x:Name="IdBadge" Background="{StaticResource GreenSoftBrush}" CornerRadius="11" Padding="10,4">
            <TextBlock x:Name="IdText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
          </Border>
          <Border x:Name="AreaBadge" Background="#222B34" CornerRadius="11" Padding="10,4" Margin="8,0,0,0">
            <TextBlock x:Name="AreaText" FontSize="11" Foreground="{StaticResource MutedBrush}" />
          </Border>
          <Border x:Name="RiskBadge" Background="#222B34" CornerRadius="11" Padding="10,4" Margin="8,0,0,0">
            <TextBlock x:Name="RiskText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <!-- Contenido -->
    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Columna izquierda: acciones, entrada, detalles -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="ACCIONES" Style="{StaticResource CardTitle}" />
            <Button x:Name="RefreshStatusButton" Content="↻  Consultar estado actual" Style="{StaticResource AccentButton}"
                    Margin="0,9,0,10" Click="RefreshStatus_Click" />
            <ItemsControl x:Name="ActionsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ActionCard}" Click="Action_Click" Tag="{Binding}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,14" />

            <TextBlock Text="ENTRADA / PARÁMETRO" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="InputHintText" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,7" />
            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="78"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
            <Button Content="Limpiar entrada" Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="ClearInput_Click" />

            <Expander Header="Detalles técnicos" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}">
              <StackPanel Margin="0,6,0,0">
                <TextBlock x:Name="TechnicalText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>

            <Border x:Name="ConfirmBar" Visibility="Collapsed" Background="{StaticResource YellowSoftBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="12" Foreground="#FFE9B8" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Confirmar" Style="{StaticResource AccentButton}" Click="Confirm_Click" />
                  <Button Content="Cancelar" Style="{StaticResource PillButton}" Click="CancelConfirm_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Columna derecha: resultado e historial -->
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <TextBlock Text="RESULTADO" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Copiar" Style="{StaticResource PillButton}" Click="Copy_Click" />
              <Button Content="Guardar" Style="{StaticResource PillButton}" Click="Save_Click" />
              <Button Content="Limpiar" Style="{StaticResource PillButton}" Click="Clear_Click" />
            </StackPanel>
          </DockPanel>
          <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="{StaticResource CanvasBrush}" Margin="0,10,0,12" />
          <StackPanel Grid.Row="2">
            <TextBlock Text="HISTORIAL DE ESTA SESIÓN" Style="{StaticResource CardTitle}" />
            <ListBox x:Name="HistoryList" Height="82" Margin="0,6,0,0"
                     Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                     Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Barra de estado -->
    <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" Padding="18,9">
      <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                   VerticalAlignment="Center" Text="Listo. Consulta el estado antes de aplicar cambios." />
        <ProgressBar x:Name="BusyBar" Width="150" Height="6" HorizontalAlignment="Right" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
