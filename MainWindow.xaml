<Window x:Class="ApexKernelOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ApexKernelOptimizer.Core.Models"
        Title="ApexKernel Optimizer" Height="940" Width="1500" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="PillTodos" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Todos">
          <Setter Property="Background" Value="#2C3E4A" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillSeguros" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Seguros">
          <Setter Property="Background" Value="#20362E" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillOpcionales" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Opcionales">
          <Setter Property="Background" Value="#3A321F" /><Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillAgresivos" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Agresivos">
          <Setter Property="Background" Value="#3D2429" /><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillActivos" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Activos">
          <Setter Property="Background" Value="#2C3E4A" /><Setter Property="BorderBrush" Value="#60A5FA" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PillRespaldados" TargetType="Button" BasedOn="{StaticResource PillButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRiskFilter}" Value="Respaldados">
          <Setter Property="Background" Value="#2C3E4A" /><Setter Property="BorderBrush" Value="#A78BFA" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DashboardButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
          <Setter Property="Background" Value="#223A2E" />
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Botones de perfiles generales: conservan su color en hover y se bloquean durante cualquier operación masiva -->
    <Style x:Key="ProfileButtonBase" TargetType="Button">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Opacity" Value="0.85" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Opacity" Value="0.7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ProfileNormalButton" TargetType="Button" BasedOn="{StaticResource ProfileButtonBase}">
      <Setter Property="Background" Value="#173B2B" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#D7F5E4" />
    </Style>
    <Style x:Key="ProfileGamingButton" TargetType="Button" BasedOn="{StaticResource ProfileButtonBase}">
      <Setter Property="Background" Value="#3A321F" />
      <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
      <Setter Property="Foreground" Value="#FBE7C2" />
    </Style>
    <Style x:Key="ProfileAllButton" TargetType="Button" BasedOn="{StaticResource ProfileButtonBase}">
      <Setter Property="Background" Value="#3D2429" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="Foreground" Value="#F8D5D9" />
    </Style>

    <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CategoryItemTemplate">
      <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}" Style="{StaticResource NavButton}" ToolTip="{Binding Label}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="15" Width="24" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ActiveCount}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="QuickAccessItemTemplate">
      <Button Command="{Binding DataContext.OpenToolByIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}" Style="{StaticResource NavButton}" Padding="10,6" ToolTip="{Binding Label}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="14" Width="22" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="OptimizationCard">
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#35404A" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="2" Margin="0,2,12,2">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#22C55E" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Yellow}"><Setter Property="Background" Value="#F59E0B" /></DataTrigger>
                  <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Red}"><Setter Property="Background" Value="#EF4444" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>

          <StackPanel Grid.Column="1" MinWidth="0">
            <DockPanel LastChildFill="True">
              <Border CornerRadius="9" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Yellow}"><Setter Property="Background" Value="{StaticResource YellowSoftBrush}" /></DataTrigger>
                      <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Red}"><Setter Property="Background" Value="{StaticResource RedSoftBrush}" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding RiskLabel}" FontSize="9.5" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#22C55E" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Yellow}"><Setter Property="Foreground" Value="#F59E0B" /></DataTrigger>
                        <DataTrigger Binding="{Binding RiskLevel}" Value="{x:Static models:RiskLevel.Red}"><Setter Property="Foreground" Value="#EF4444" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center">
                <Run Text="#" /><Run Text="{Binding Id, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" ToolTip="{Binding Title}" />
            </DockPanel>

            <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShortDescription}" FontSize="12" />
            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="0,5,0,0" />
            <TextBlock Text="{Binding Status}" Foreground="#8FA3B3" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap">
              <Run Text="● Activo: " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
              <Run Text="{Binding AppliedOptionText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
              <Run Text="    Actual: " Foreground="{StaticResource DimBrush}" />
              <Run Text="{Binding CurrentValueText, Mode=OneWay}" FontFamily="Consolas" />
              <Run Text="    → Objetivo: " Foreground="{StaticResource DimBrush}" />
              <Run Text="{Binding TargetValueText, Mode=OneWay}" FontFamily="Consolas" />
            </TextBlock>

            <Expander Header="Detalle técnico" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,6,0,0">
              <StackPanel Margin="10,6,4,2">
                <TextBlock Text="{Binding TechnicalSummary}" Foreground="#93A1AD" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" FontSize="10.5" Foreground="#F59E0B" TextWrapping="Wrap">
                  <Run Text="Valor oficial (Defecto): " /><Run Text="{Binding DefaultValueText, Mode=OneWay}" FontFamily="Consolas" />
                </TextBlock>
                <TextBlock Text="{Binding WarningMessage}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" TextWrapping="Wrap">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding WarningMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Expander>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="14,0,0,0" MinWidth="132">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding SelectedValue}"
                      MinWidth="150" Height="30" Margin="0,0,0,8" FontSize="11" ToolTip="Elige el valor que se aplicará al pulsar Aplicar.">
              <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.Style>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTool}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button Content="Aplicar" Padding="8,4" Margin="0,0,5,0" FontSize="10.5"
                      Command="{Binding DataContext.ApplyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" Foreground="{StaticResource AccentBrush}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CanApply}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Restaurar" Padding="8,4" Margin="0,0,5,0" FontSize="10.5"
                      Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" Foreground="#8FA3B3"
                      ToolTip="Vuelve al estado anterior guardado por ApexKernel.">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CanRestore}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Defecto" Padding="8,4" FontSize="10.5"
                      Command="{Binding DataContext.SetDefaultItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" Foreground="#F59E0B"
                      ToolTip="Aplica el valor oficial documentado de Windows, no el valor que tenía este equipo.">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CanSetDefault}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>
            <Button Content="Abrir herramienta →" Click="OpenTool_Click" Margin="0,10,0,0" Padding="9,6" FontSize="11"
                    HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTool}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="245" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== BARRA LATERAL ===== -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#242C34" BorderThickness="0,0,1,0">
      <Grid Margin="0,18,0,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,0,16,16">
          <TextBlock Text="ApexKernel Optimizer" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="Suite Nativa de Rendimiento" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
          <TextBlock Text="Windows · catálogo universal · sin dependencias" Foreground="{StaticResource DimBrush}" FontSize="9.5" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,0,8,0">
            <Button Content="⌂   Inicio / Panel de Control" Command="{Binding ShowDashboardCommand}" Style="{StaticResource DashboardButton}" FontWeight="SemiBold" />
            <TextBlock Text="CATEGORÍAS" Style="{StaticResource SectionTitle}" Margin="12,18,0,6" />
            <ItemsControl ItemsSource="{Binding CategoryNav}" ItemTemplate="{StaticResource CategoryItemTemplate}" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="8,10,8,0">
          <TextBlock Text="ACCESOS DIRECTOS" Style="{StaticResource SectionTitle}" Margin="12,0,0,6" />
          <ItemsControl ItemsSource="{Binding QuickAccess}" ItemTemplate="{StaticResource QuickAccessItemTemplate}" />
          <TextBlock Margin="12,10,6,0" FontSize="9.5" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"
                     Text="La detección solo informa compatibilidad; no presupone marca ni configuración concreta." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== ZONA PRINCIPAL ===== -->
    <Grid Grid.Column="1" Margin="18,14,18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Cabecera: buscador, filtros y progreso -->
      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <DockPanel LastChildFill="False">
          <Grid Width="540" DockPanel.Dock="Left">
            <TextBox x:Name="SearchTextBox" Height="38" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar por nombre, categoría, ID o detalle técnico" />
            <TextBlock Text="Buscar entre 227 ajustes (ej. mouse, ping, valorant, ram, usb)..." IsHitTestVisible="False"
                       Foreground="{StaticResource DimBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,36,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Content="✕" Command="{Binding ClearSearchCommand}" Width="30" Height="28" Padding="0"
                    HorizontalAlignment="Right" Margin="0,0,6,0" FontSize="12" ToolTip="Limpiar búsqueda" />
          </Grid>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="126" Height="30" Margin="0,0,10,0" FontSize="11" ToolTip="Tema visual (se guarda automáticamente)" />
            <Button Content="MODO PRO ▤" Command="{Binding ToggleProModeCommand}" Padding="12,8" Margin="0,0,14,0"
                    FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                    ToolTip="Vista profesional: valores actuales/objetivo, selección múltiple y acciones masivas." />
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center">
              <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" ajustes · " />
              <Run Text="{Binding ToolCount, Mode=OneWay}" /><Run Text=" herramientas · " />
              <Run Text="{Binding ActiveCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" /><Run Text=" activos · " />
              <Run Text="{Binding BackedUpCount, Mode=OneWay}" Foreground="#A78BFA" /><Run Text=" respaldados" />
            </TextBlock>
          </StackPanel>
        </DockPanel>

        <WrapPanel Margin="0,10,0,0">
          <Button Content="Todos (227)" Style="{StaticResource PillTodos}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Todos" />
          <Button Style="{StaticResource PillSeguros}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Seguros">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🟢 Seguros" /><TextBlock Text="{Binding GreenFilterCount}" Margin="6,0,0,0" Foreground="#22C55E" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PillOpcionales}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Opcionales">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🟡 Opcionales" /><TextBlock Text="{Binding YellowFilterCount}" Margin="6,0,0,0" Foreground="#F59E0B" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PillAgresivos}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Agresivos">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🔴 Agresivos" /><TextBlock Text="{Binding RedFilterCount}" Margin="6,0,0,0" Foreground="#EF4444" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PillActivos}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Activos">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✅ Activos" /><TextBlock Text="{Binding ActiveCount}" Margin="6,0,0,0" Foreground="#60A5FA" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PillRespaldados}" Command="{Binding SetRiskFilterCommand}" CommandParameter="Respaldados">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="💾 Respaldados" /><TextBlock Text="{Binding BackedUpCount}" Margin="6,0,0,0" Foreground="#A78BFA" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Width="110" Value="{Binding OperationProgress, Mode=OneWay}" Maximum="100" Margin="0,0,8,0" />
            <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource AccentBrush}" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <!-- Cuerpo: Dashboard o listado -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="PANEL DE CONTROL" FontSize="20" FontWeight="Bold" Margin="2,0,0,4" />
            <TextBlock Text="Estado del equipo y acciones rápidas. Todo se ejecuta con los componentes nativos de ApexKernel."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,14" />

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

              <!-- PROCESADOR -->
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="PROCESADOR" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{Binding CpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding CpuCores}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding X3dNotice}" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding X3dNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                          <DataTrigger Binding="{Binding Hardware.IsDualCcdX3d}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- MEMORIA RAM -->
              <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="MEMORIA RAM" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{Binding MemoryTotalGb, StringFormat={}{0:0.#} GB}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}% de uso}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0" />
                  <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                  <Button Content="Purgar Standby" Command="{Binding PurgeStandbyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,5" FontSize="11" />
                </StackPanel>
              </Border>

              <!-- GRÁFICOS / GPU -->
              <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,10,10">
                <StackPanel>
                  <TextBlock Text="GRÁFICOS / GPU" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{Binding GraphicsModel}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding HagsStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,7,0,0" />
                  <Button Content="Reiniciar Driver" Command="{Binding ResetGraphicsDriverCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,5" FontSize="11" />
                </StackPanel>
              </Border>

              <!-- SISTEMA Y ANTICHEAT -->
              <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="SISTEMA Y ANTICHEAT" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{Binding WindowsInfo}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding DriveInfoText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding FormFactorText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0" />
                  <Border Background="#20362E" BorderBrush="#2E7D52" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AntiCheatBadges}" Foreground="#B8E3D0" FontSize="11" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>

            <!-- TELEMETRÍA EN VIVO -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,4,0,12">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="TELEMETRÍA EN VIVO" Style="{StaticResource CardTitle}" />
                  <Button Content="↻ Actualizar" Command="{Binding RefreshTelemetryCommand}" DockPanel.Dock="Right"
                          Padding="8,4" FontSize="10.5" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="Muestreo automático cada 5 segundos · valores reales del sistema" Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="0,4,0,10" />
                <UniformGrid Columns="3" Rows="2">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding CpuLoad, StringFormat={}{0:0}%}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Height="38" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,8">
                    <StackPanel>
                      <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding MemoryUsagePercent, StringFormat={}{0:0}%}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <Polyline Points="{Binding RamPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Height="38" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding GpuLoad, StringFormat={}{0:0}%}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <Polyline Points="{Binding GpuPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Height="38" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="LATENCIA" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding NetLatencyMs, StringFormat={}{0:0} ms}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <Polyline Points="{Binding NetPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Height="38" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="DISCO" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding DiskLoad, StringFormat={}{0:0}%}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <Polyline Points="{Binding DiskPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Stretch="Uniform" Height="38" />
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                    <StackPanel>
                      <TextBlock Text="PROCESOS" FontSize="10" Foreground="{StaticResource DimBrush}" />
                      <TextBlock Text="{Binding ProcessCount}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                      <TextBlock Text="activos en el sistema" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,14,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- Barra de acciones masivas -->
            <Border Background="#182822" BorderBrush="#284B3D" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,4,0,10">
              <StackPanel>
                <TextBlock Text="ACCIONES MASIVAS" Style="{StaticResource CardTitle}" Foreground="#B8E3D0" Margin="0,0,0,10" />
                <WrapPanel>
                  <Button Content="⚡ Aplicar Todos los Seguros (Verdes)" Command="{Binding ApplyAllSafeCommand}" Style="{StaticResource AccentButton}" />
                  <Button Content="↩️ Revertir Todo lo Respaldado" Command="{Binding RevertBackedUpCommand}" />
                  <Button Content="📄 Informe HTML" Command="{Binding ExportReportCommand}" CommandParameter="html" />
                  <Button Content="🧾 Informe JSON" Command="{Binding ExportReportCommand}" CommandParameter="json" />
                  <Button Content="📝 Informe MD" Command="{Binding ExportReportCommand}" CommandParameter="md" />
                  <Button Content="🛡️ Crear Punto de Restauración" Command="{Binding CreateRestorePointCommand}" />
                  <Button Content="🎮 Modo Competitivo / Eco" Command="{Binding ToggleCompetitiveModeCommand}" />
                  <Button Content="📂 Exportar Perfil" Click="ExportProfile_Click" />
                  <Button Content="📂 Importar Perfil" Click="ImportProfile_Click" />
                </WrapPanel>
                <TextBlock Text="{Binding OperationStatus}" Foreground="#B8E3D0" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Perfiles generales de uso -->
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,4,0,10">
              <StackPanel>
                <TextBlock Text="PERFILES DE USO" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock Text="Tres puntos de partida rápidos. Revisa la confirmación: los ajustes ya activos o no compatibles se omiten."
                           Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Button Grid.Column="0" Command="{Binding ApplyNormalProfileCommand}" Style="{StaticResource ProfileNormalButton}" Margin="0,0,6,0"
                          ToolTip="Aplica una selección curada de ajustes de comodidad, privacidad y estabilidad.">
                    <StackPanel>
                      <TextBlock Text="🟢  USO NORMAL (EQUILIBRADO)" FontSize="12.5" FontWeight="Bold" Foreground="#7FE3A8" TextWrapping="Wrap" />
                      <TextBlock Text="Diario y seguro: comodidad, privacidad y estabilidad. Sin seguridad, anticheat ni servicios críticos."
                                 FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="1" Command="{Binding ApplyGamingProfileCommand}" Style="{StaticResource ProfileGamingButton}" Margin="6,0,6,0"
                          ToolTip="Crea un punto de restauración y aplica ajustes de CPU, GPU, red, audio y juego.">
                    <StackPanel>
                      <TextBlock Text="🎮  MODO GAMING (BAJA LATENCIA)" FontSize="12.5" FontWeight="Bold" Foreground="#FCD34D" TextWrapping="Wrap" />
                      <TextBlock Text="Competitivo: CPU, GPU, red, audio y juego. Crea punto de restauración antes de aplicar."
                                 FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="2" Command="{Binding ApplyAlmostAllProfileCommand}" Style="{StaticResource ProfileAllButton}" Margin="6,0,0,0"
                          ToolTip="NO RECOMENDADO: aplica verde + ámbar salvo denylist de seguridad. Crea punto de restauración.">
                    <StackPanel>
                      <TextBlock Text="🔴  APLICAR CASI TODO (NO RECOMENDADO)" FontSize="12.5" FontWeight="Bold" Foreground="#FCA5A5" TextWrapping="Wrap" />
                      <TextBlock Text="Todos los verdes y ámbar excepto seguridad. Puede dejar el sistema inestable o bloquear anticheat."
                                 FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="Tras aplicar, usa '↩️ Revertir Todo lo Respaldado' en Acciones masivas para volver atrás."
                           Foreground="{StaticResource DimBrush}" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Listado virtualizado de ajustes -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="List"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
              <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="{Binding SelectedCategoryOption.Label}" FontSize="17" FontWeight="Bold" DockPanel.Dock="Left" />
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="12,3,0,0">
            <Run Text="{Binding FilteredItems.Count, Mode=OneWay}" /><Run Text=" resultados · usa Aplicar / Restaurar / Defecto o abre la herramienta para explorar" />
          </TextBlock>
        </DockPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredItems}" ItemTemplate="{StaticResource OptimizationCard}"
                 ItemContainerStyle="{StaticResource CardContainerStyle}" Background="Transparent" BorderThickness="0"
                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" />
      </Grid>

      <!-- ===== VISTA PROFESIONAL ===== -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="Pro"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
            <Button Content="↻ Actualizar valores" Command="{Binding RefreshProValuesCommand}" Padding="9,5" Margin="0,0,8,0" FontSize="11" />
            <Button Content="✔ Aplicar seleccionados" Command="{Binding ApplySelectedCommand}" Padding="9,5" Margin="0,0,8,0" FontSize="11"
                    Foreground="{StaticResource AccentBrush}" />
            <Button Content="↩ Restaurar seleccionados" Command="{Binding RevertSelectedCommand}" Padding="9,5" FontSize="11"
                    Foreground="#A78BFA" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="VISTA PROFESIONAL" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="Valores reales del sistema, selección múltiple y aplicación por lotes. Los filtros y la búsqueda de la cabecera también aplican aquí."
                       Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredItems}" AutoGenerateColumns="False"
                  Background="Transparent" RowBackground="#141B21" AlternatingRowBackground="#182129"
                  Foreground="#D6E2EA" BorderBrush="#242C34" BorderThickness="1"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#242C34"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" SelectionMode="Extended" FontSize="11.5"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="34" />
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="46" IsReadOnly="True" />
            <DataGridTextColumn Header="Ajuste" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
            <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryLabel}" Width="150" IsReadOnly="True" />
            <DataGridTextColumn Header="Riesgo" Binding="{Binding RiskLabel}" Width="78" IsReadOnly="True" />
            <DataGridTextColumn Header="Opción activa" Binding="{Binding AppliedOptionText, Mode=OneWay}" Width="190" IsReadOnly="True" />
            <DataGridTextColumn Header="Valor actual" Binding="{Binding CurrentValueText, Mode=OneWay}" Width="140" IsReadOnly="True" />
            <DataGridTextColumn Header="Objetivo" Binding="{Binding TargetValueText, Mode=OneWay}" Width="140" IsReadOnly="True" />
            <DataGridTemplateColumn Header="Opción" Width="175">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedValue, Mode=TwoWay}" FontSize="11">
                    <ComboBox.Style>
                      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasOptions}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ComboBox.Style>
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsEnabled}" IsReadOnly="True" Width="62" />
            <DataGridTemplateColumn Header="Acción" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Aplicar" Padding="6,3" Margin="0,0,4,0" FontSize="10"
                            Command="{Binding DataContext.ApplyItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" Foreground="{StaticResource AccentBrush}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanApply}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="Restaurar" Padding="6,3" Margin="0,0,4,0" FontSize="10"
                            Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRestore}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="Defecto" Padding="6,3" FontSize="10" Foreground="#F59E0B"
                            Command="{Binding DataContext.SetDefaultItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanSetDefault}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Consola de auditoría colapsable -->
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="9" Padding="12" Margin="0,12,0,0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{Binding LogToggleLabel}" Command="{Binding ToggleLogCommand}"
                    Padding="8,4" FontSize="11" Margin="0" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="CONSOLA DE AUDITORÍA" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <Button Content="Copiar Log" Click="CopyLog_Click" Padding="9,4" FontSize="11" />
              <Button Content="Limpiar Log" Click="ClearLog_Click" Padding="9,4" FontSize="11" />
              <Button Content="Abrir Carpeta de Logs" Click="OpenLogs_Click" Padding="9,4" FontSize="11" Margin="0" />
            </StackPanel>
          </DockPanel>
          <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                   FontFamily="Consolas" FontSize="11" Height="{Binding LogListHeight}" SelectionMode="Single" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
